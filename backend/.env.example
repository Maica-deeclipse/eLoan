# Django Secret Key
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Google OAuth Web Client ID
# Get this from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Must be the "Web application" type client ID (used to verify id_token audience)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Comma-separated list of allowed hosts (no spaces)
# For dev: localhost,127.0.0.1,<your-local-ip>
# For production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated CORS allowed origins (no trailing slashes)
# For dev: include http://<your-local-ip>:3000 and :8081 for physical device testing
# For production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19006

# Email Configuration
# For development: django.core.mail.backends.console.EmailBackend
# For production:  django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Your Gmail credentials
# Replace with your actual Gmail address
EMAIL_HOST_USER=your-email@gmail.com

# App Password from https://myaccount.google.com/apppasswords
# This is NOT your regular Gmail password!
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# From email address (can be same as EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Frontend URL for password reset links (no trailing slash)
FRONTEND_URL=http://localhost:3000

# File Encryption Key (Fernet key — must be stable, never regenerate after files are encrypted)
# Generate a new one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Changing this key makes ALL previously encrypted files (IDs, payslips, face photos) unreadable
ENCRYPTION_KEY=your-fernet-key-here

# HTTPS / Cookie Security (set to True in production, leave False for local dev)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database Configuration
DB_NAME=eloan
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306
