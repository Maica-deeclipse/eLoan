# Email Configuration for Production

# SMTP Backend (change from console to smtp for real emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Your Gmail credentials
# Replace with your actual Gmail address
EMAIL_HOST_USER=your-email@gmail.com

# App Password from https://myaccount.google.com/apppasswords
# This is NOT your regular Gmail password!
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# From email address (can be same as EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000

# Database Configuration (optional, defaults in settings.py)
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
